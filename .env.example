CODEX_QUOTA_WIDGET_TOKEN=replace-with-output-of-openssl-rand-hex-18
CODEX_QUOTA_WIDGET_HOST=127.0.0.1
CODEX_QUOTA_WIDGET_PORT=8765

# single-account mode reads regular Codex ChatGPT auth directly.
# Run `codex login` and choose Sign in with ChatGPT, not API-key-only login.
# CODEX_AUTH_FILE=/home/you/.codex/auth.json
# CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
# CODEX_RESET_CREDITS_URL=https://chatgpt.com/backend-api/wham/rate-limit-reset-credits

# multi-account mode uses CLIProxyAPI when CLIPROXY_MANAGEMENT_KEY is set.
# CLIPROXY_MANAGEMENT_KEY=your-management-password
# CLIPROXY_BASE_URL=http://127.0.0.1:8317
